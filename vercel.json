{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/settings/:path*",
      "destination": "/api/settings/:path*"
    },
    {
      "source": "/deliveryPartners",
      "destination": "/api/deliveryPartners"
    },
    {
      "source": "/restaurant_products",
      "destination": "/api/restaurant_products"
    },
    {
      "source": "/restaurant_products/:path*",
      "destination": "/api/restaurant_products/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "db.json",
      "maxDuration": 30
    },
    "api/[...path].js": {
      "includeFiles": "db.json",
      "maxDuration": 30
    },
    "api/hello.js": {
      "maxDuration": 10
    }
  }
}
