{
  "info": {
    "name": "VAYZO Admin - Categories API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminToken",
      "value": "vayzo_admin_mock_token_123"
    },
    {
      "key": "categoryId",
      "value": "CAT1790151636590588"
    },
    {
      "key": "parentItemId",
      "value": "M1791393367780"
    },
    {
      "key": "childItemId",
      "value": "M1791445948731"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "categories"]
            }
          }
        },
        {
          "name": "Get Category By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.id) pm.collectionVariables.set('categoryId', data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"South Indian Foods\",\n  \"categoryId\": \"CAT2045\",\n  \"type\": \"Food\",\n  \"status\": \"Active\",\n  \"description\": \"Delicious south indian delicacies\",\n  \"parentId\": \"Food Delivery\",\n  \"scope\": \"Global\",\n  \"image\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "categories"]
            }
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"South Indian Foods Updated\",\n  \"type\": \"Food\",\n  \"status\": \"Inactive\",\n  \"description\": \"Updated description\",\n  \"parentId\": \"Food Delivery\",\n  \"scope\": \"Global\",\n  \"image\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "categories", "{{categoryId}}"]
            }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "categories", "{{categoryId}}"]
            }
          }
        }
      ]
    },
    {
